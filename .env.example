# Backend
DATABASE_URL=postgres://user:pass@localhost:5432/booking?sslmode=disable
PORT=8080

# Firebase (JSON string of service account)
FIREBASE_SERVICE_ACCOUNT_JSON={}

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id

# SMTP
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=password
SMTP_DOMAIN=example.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://ma3ady.com,https://www.ma3ady.com

# Mobile (set in app.json extra)
# API_BASE_URL=https://api.ma3ady.com/api/v1
